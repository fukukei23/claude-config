# APIキー・シークレット管理ファイル
# このファイルはGitHubにpushしないこと
# パーミッション: 600 (所有者のみ読み書き)

# MiniMax の API キー（フォールバック用）
export MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY_HERE

# GitHub Personal Access Token
export GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# Brave Search API キー
export BRAVE_API_KEY=YOUR_BRAVE_API_KEY_HERE

# GLM/Z.ai の API キー（Claude Code の ANTHROPIC_AUTH_TOKEN として読み込まれる）
export ANTHROPIC_AUTH_TOKEN=YOUR_ANTHROPIC_AUTH_TOKEN_HERE
