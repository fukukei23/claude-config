#!/usr/bin/env bash
# pre-commit: stage内容の見える化（並行セッション巻き込み事故防止・2026-07-25）
# ブロックせず表示のみ（multi-llm-review 3機レビュー反映・副作用最小）
files=$(git diff --cached --name-only)
if [ -z "$files" ]; then
  count=0
else
  count=$(echo "$files" | wc -l)
fi
echo "--- staged ($count files) ---"
[ -n "$files" ] && echo "$files"
if [ "$count" -gt 10 ]; then
  echo "⚠️ $count ファイル staged・並行セッション巻き込み確認"
  echo "   戻す: git restore --staged <file>"
fi

# review_policy.yaml 参照化ゲート（G3・spec §3.6・YAML構文→直書きgrep→pytest）
# ポリシー関連ファイルがstagedされた時のみ実行・SKIP_GREP=1でgrepスキップ可
bash "$(git rev-parse --show-toplevel)/scripts/hooks/check-review-policy-gate.sh"
exit $?
