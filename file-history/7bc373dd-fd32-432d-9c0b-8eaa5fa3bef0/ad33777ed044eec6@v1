[Unit]
Description=tmux krokod session for Claude Code
After=network.target

[Service]
Type=forking
ExecStart=/bin/bash -c 'tmux has-session -t krokod 2>/dev/null || tmux new-session -d -s krokod "BROWSER=none claude --channels plugin:discord@claude-plugins-official"'
ExecStop=/bin/bash -c 'tmux kill-session -t krokod 2>/dev/null; true'
Restart=no
Environment=HOME=/home/yn441611
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
