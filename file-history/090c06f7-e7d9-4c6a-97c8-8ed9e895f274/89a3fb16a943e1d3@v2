#!/usr/bin/env bun
/**
 * Discord チャンネル自動同期スクリプト
 * Guildの全テキストチャンネルをaccess.jsonのgroupsに追加する
 * 既存のエントリは保持し、新規チャンネルのみ追加する
 */

import { readFileSync, writeFileSync } from "fs";
import { join } from "path";

const STATE_DIR = process.env.DISCORD_STATE_DIR ?? join(process.env.HOME!, ".claude/channels/discord");
const ACCESS_JSON = join(STATE_DIR, "access.json");
const ENV_FILE = join(STATE_DIR, ".env");

// .envからBOT_TOKENを取得
function loadToken(): string {
  const env = readFileSync(ENV_FILE, "utf-8");
  const match = env.match(/DISCORD_BOT_TOKEN=(.+)/);
  if (!match) throw new Error("DISCORD_BOT_TOKEN not found in .env");
  return match[1].trim();
}

// Discord APIからguild一覧を取得してguild IDを特定
async function getGuildId(token: string): Promise<string> {
  const res = await fetch("https://discord.com/api/v10/users/@me/guilds", {
    headers: { Authorization: `Bot ${token}` },
  });
  const guilds: any[] = await res.json();
  if (!guilds.length) throw new Error("No guilds found");
  return guilds[0].id; // 最初のguildを使用
}

// テキストチャンネルのtype定数
const TEXT_CHANNEL_TYPES = new Set([0, 5, 10, 11, 12]); // GUILD_TEXT, GUILD_ANNOUNCEMENT, thread types

async function syncChannels() {
  const token = loadToken();
  const guildId = await getGuildId(token);

  const res = await fetch(`https://discord.com/api/v10/guilds/${guildId}/channels`, {
    headers: { Authorization: `Bot ${token}` },
  });
  const channels: any[] = await res.json();

  const textChannels = channels.filter((c) => TEXT_CHANNEL_TYPES.has(c.type));

  // access.jsonを読み込む
  const access = JSON.parse(readFileSync(ACCESS_JSON, "utf-8"));
  if (!access.groups) access.groups = {};

  let added = 0;
  for (const ch of textChannels) {
    if (!access.groups[ch.id]) {
      access.groups[ch.id] = { requireMention: true, allowFrom: [] };
      added++;
      console.log(`Added: ${ch.id} (${ch.name})`);
    }
  }

  writeFileSync(ACCESS_JSON, JSON.stringify(access, null, 2) + "\n");
  console.log(`Sync complete: ${added} new channel(s) added, ${textChannels.length} total.`);
}

syncChannels().catch((e) => {
  console.error(e);
  process.exit(1);
});
