{
  "zai_base_url": "https://api.z.ai/api/anthropic",
  "minimax_base_url": "https://api.minimax.io/anthropic/v1",
  "listen_host": "127.0.0.1",
  "listen_port": 8787,
  "upstream_timeout": 1200,
  "log_level": "INFO",
  "default_model": "glm-5.2",
  "status_file": "/tmp/glm-rate-proxy-status.json",
  "thresholds": {
    "normal": {
      "max_pct": 80,
      "model": null
    },
    "economy": {
      "max_pct": 95,
      "model": "GLM-5"
    },
    "emergency": {
      "max_pct": 100,
      "model": "GLM-4.7"
    }
  },
  "fallback": {
    "provider": "minimax",
    "model": "MiniMax-M3"
  },
  "peak_hours": {
    "enabled": true,
    "start_hour": 15,
    "end_hour": 19,
    "timezone_offset": 9
  }
}