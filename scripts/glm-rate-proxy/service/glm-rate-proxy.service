[Unit]
Description=glm-rate-proxy - Claude Code Rate Limiting Proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m glm_rate_proxy
WorkingDirectory=%h/projects/claude-config/scripts/glm-rate-proxy
EnvironmentFile=%h/.claude/.env
EnvironmentFile=%h/.secrets.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
