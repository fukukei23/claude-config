[Unit]
Description=glm-rate-proxy - Claude Code Rate Limiting Proxy
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'set -a; source %h/.claude/.env 2>/dev/null; source %h/.secrets.env 2>/dev/null; set +a; cd %h/projects/claude-config/scripts/glm-rate-proxy; PYTHONPATH=src exec /usr/bin/python3 -m glm_rate_proxy'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
